  <interface name="bevy_viewer" label="Bevy Viewer" icon="MISC_python" showNetworkNavigationBar="false" help_url="">
    <script><![CDATA[from importlib import reload
import bevy_viewer


def onCreateInterface():

    reload(bevy_viewer)
    return bevy_viewer.main_panel.create_viewer_layout()
]]></script>
    <includeInToolbarMenu menu_position="202" create_separator="false"/>
    <help><![CDATA[]]></help>
  </interface>
